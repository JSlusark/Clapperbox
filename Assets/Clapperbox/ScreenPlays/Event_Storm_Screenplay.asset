  m_Script: {fileID: 11500000, guid: f184b252e1b54560a20c7608492a0f79, type: 3}
  m_Name: Event_Storm_Screenplay
  m_EditorClassIdentifier: Assembly-CSharp::DefaultNamespace.ScreenPlayData
  dialogueList:
  - speaker: Tuto
    text: Did you hear that? Thunder already!
    expression: Surprised
  - speaker: Rial
    text: The clouds came out of nowhere. That is not a normal storm.
    expression: Neutral
  - speaker: Tuto
    text: If the rain reaches the lantern the flame will go out for good.
    expression: Sad
  - speaker: Rial
    text: Then I suggest we stop talking and start running.
    expression: Sassy
  - speaker: Tuto
    text: The tower is just ahead. Stay close to me!
    expression: Happy
  - speaker: Rial
    text: Do not worry. I am an excellent runner when I am scared.
    expression: Cheeky
  - speaker: Tuto
    text: We made it. Now let us light this lantern once and for all.
    expression: Neutral
  characters:
