  dialogueList:
  - speaker: Tuto
    text: Oh no! The key to the lantern tower is gone!
    expression: 5
    invalidExpression: None
  - speaker: Rial
    text: Have you checked your pockets? All twelve of them?
    expression: 7
    invalidExpression: None
  - speaker: Tuto
    text: Of course I checked my pockets!
    expression: 4
    invalidExpression: None
  - speaker: Rial
    text: Then I guess it grew legs and walked off. Happens to the best of us.
    expression: 6
    invalidExpression: None
  - speaker: Tuto
    text: Without that key we cannot reach the top of the hill.
    expression: 3
    invalidExpression: None
  - speaker: Rial
    text: Fine. I saw a crow carrying something shiny toward the old well.
    expression: 1
    invalidExpression: None
  - speaker: Tuto
    text: Rial! Why did you not say so sooner?
    expression: 2
    invalidExpression: None
