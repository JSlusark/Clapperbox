  m_Script: {fileID: 11500000, guid: f184b252e1b54560a20c7608492a0f79, type: 3}
  m_Name: Event_LostKey_Screenplay
  m_EditorClassIdentifier: Assembly-CSharp::DefaultNamespace.ScreenPlayData
  dialogueList:
  - speaker: Tuto
    text: Oh no! The key to the lantern tower is gone!
    expression: Surprised
  - speaker: Rial
    text: Have you checked your pockets? All twelve of them?
    expression: Cheeky
  - speaker: Tuto
    text: Of course I checked my pockets!
    expression: Angry
  - speaker: Rial
    text: Then I guess it grew legs and walked off. Happens to the best of us.
    expression: Sassy
  - speaker: Tuto
    text: Without that key we cannot reach the top of the hill.
    expression: Sad
  - speaker: Rial
    text: Fine. I saw a crow carrying something shiny toward the old well.
    expression: Neutral
  - speaker: Tuto
    text: Rial! Why did you not say so sooner?
    expression: Happy
